    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { KTX2Loader } from 'three/addons/loaders/KTX2Loader.js';
        import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';
        import { FaceLandmarker, FilesetResolver } from './vendor/mediapipe/vision_bundle.mjs';

        // ── Anamorphic depth illusion config ──
        const CONFIG = {
            screenWidthCm: 52,
            screenHeightCm: 32,
            defaultDistanceCm: 55,
            movementScale: 1.6,
            smoothing: 0.65,
            roomDepth: 80,
            roomWidth: 80,
            roomHeight: 50,
            near: 1,
            far: 500,
            avgIpdCm: 6.3,
            alienScale: 22,
            alienDepth: -25,
        };

        const COLORS = {
            dim: 0x1a2a55,
            grid: 0x3366ff,
            object: 0x4488ff,
            frame: 0x6699ff,
            pop: 0x88bbff,
        };

        // ── DOM elements ──
        const canvas = document.getElementById('three-canvas');
        const webcamPreview = document.getElementById('webcam-preview');
        const loadingOverlay = document.getElementById('loading-overlay');
        const loadingText = document.getElementById('loading-text');
        const loadingSubtext = document.getElementById('loading-subtext');
        const statusElement = document.getElementById('status');
        const errorMessage = document.getElementById('error-message');
        const modelButtons = document.querySelectorAll('.model-btn:not(.coming-soon)');
        const facePlaceholder = document.getElementById('face-placeholder');

        // ── Installation UI ──
        const attractEl = document.getElementById('attract');
        const attractGallery = document.getElementById('attract-gallery');
        const setupPanel = document.getElementById('setup-panel');
        const cameraSelect = document.getElementById('camera-select');
        const modelSelect = document.getElementById('model-select');
        const captureCountEl = document.getElementById('capture-count');
        const toggleKioskBtn = document.getElementById('toggle-kiosk');
        const toggleCaptureBtn = document.getElementById('toggle-capture');

        // ── Installation config (persisted on the mini PC) ──
        const STORE_KEY = 'faceAvatar.settings.v2';
        const GALLERY_KEY = 'faceAvatar.gallery';
        const settings = Object.assign(
            { cameraId: '', kiosk: false, captureEnabled: true },
            JSON.parse(localStorage.getItem(STORE_KEY) || '{}')
        );
        function saveSettings() { localStorage.setItem(STORE_KEY, JSON.stringify(settings)); }

        // ── Attract / capture state ──
        const ATTRACT_DELAY_MS = 6000;   // idle time before the attract loop takes over
        const CAPTURE_HOLD_MS = 2500;    // steady tracking required before we snapshot someone
        const CAPTURE_COOLDOWN_MS = 4000;// min gap between snapshots of the same visitor
        // ?preview shows the avatar without a live face (on-site setup / model checks).
        const previewMode = new URLSearchParams(location.search).has('preview');
        let attractActive = false;
        let attractTimer = 0;
        let faceStableSince = 0;
        let capturedThisVisit = false;
        let lastCaptureAt = 0;
        let gallery = JSON.parse(localStorage.getItem(GALLERY_KEY) || '[]');
        const MAX_GALLERY = 24;

        // ── Head tracking state ──
        let headX = 0, headY = 0, headZ = CONFIG.defaultDistanceCm;
        let smoothX = 0, smoothY = 0, smoothZ = CONFIG.defaultDistanceCm;
        let tracking = false;
        let lastFaceTime = 0;

        // ── Three.js ──
        let scene, camera, renderer;
        let wireframeObjects = [];
        let wireframeBasePositions = [];
        let sharedLineMaterials = {};
        let animationTime = 0;

        // ── Avatar ──
        let currentModelUrl = 'vendor/pink-alien-RIGGED.glb';
        let avatarModel = null;
        let headBone = null;
        let morphTargetMeshes = [];
        let morphTargetIndices = {};
        let proceduralMeshes = [];
        let modelBounds = { min: new THREE.Vector3(), max: new THREE.Vector3(), center: new THREE.Vector3() };

        // ── Face tracking ──
        let faceLandmarker = null;
        let videoStream = null;
        let lastVideoTime = -1;
        let faceDetected = false;
        let avatarVisible = false;
        let faceDetectionCounter = 0;
        const FACE_DETECT_THRESHOLD = 5;
        const FACE_LOST_THRESHOLD = 15;
        const smoothedBlendshapes = {};
        const smoothedRotation = { pitch: 0, yaw: 0, roll: 0 };
        const SMOOTHING_FACTOR = 0.5;

        // --- Expression calibration + per-channel gain (inspired by gnm-webcam-puppet) ---
        // neutralBlendshapes: the user's resting-face baseline, subtracted each frame so
        // a resting face reads as zero expression. Populated by "Calibrate" button.
        const neutralBlendshapes = {};
        let calibrated = false;
        let calibrateSamples = 0;
        let calibrateAccum = {};
        let calibrating = false;
        // Per-channel GAIN: raw MediaPipe scores are often weak; multiply then clamp to [0,1].
        // Tuned so a natural open-mouth / full blink drives the morph fully.
        const EXPR_GAIN = {
            jawOpen: 1.7,
            eyeBlinkLeft: 1.6, eyeBlinkRight: 1.6,
            mouthSmileLeft: 1.4, mouthSmileRight: 1.4,
            mouthFunnel: 1.3, mouthPucker: 1.3,
            browInnerUp: 1.3, browDownLeft: 1.3, browDownRight: 1.3,
            cheekPuff: 1.4
        };
        // small dead-zone so tiny tracker jitter at rest doesn't twitch the face
        const EXPR_DEADZONE = 0.04;
        function calibratedScore(name, raw) {
            let v = raw;
            if (calibrated && neutralBlendshapes[name] !== undefined) {
                // subtract baseline, renormalize the remaining range to [0,1]
                const base = neutralBlendshapes[name];
                v = (raw - base) / Math.max(0.0001, 1 - base);
            }
            if (v < EXPR_DEADZONE) v = 0;
            const g = EXPR_GAIN[name] || 1.0;
            v = v * g;
            if (v < 0) v = 0; else if (v > 1) v = 1;
            return v;
        }

        const BLENDSHAPE_NAMES = [
