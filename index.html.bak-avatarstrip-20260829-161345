        async function initFaceLandmarker() {
            showLoading('Initializing Face Tracking', 'Setting up AI-powered detection...');
            try {
                const filesetResolver = await FilesetResolver.forVisionTasks(
                    './vendor/mediapipe/wasm'
                );
                faceLandmarker = await FaceLandmarker.createFromOptions(filesetResolver, {
                    baseOptions: {
                        modelAssetPath: './vendor/mediapipe/model/face_landmarker.task',
                        delegate: 'GPU'
                    },
                    outputFaceBlendshapes: true,
                    outputFacialTransformationMatrixes: true,
                    runningMode: 'VIDEO',
                    numFaces: 1
                });
                updateStatus('Face tracking ready');
                statusElement.className = '';
                hideLoading();
            } catch (error) {
                console.error('Error initializing FaceLandmarker:', error);
                showError('Face tracking unavailable — using mouse fallback');
                hideLoading();
            }
        }

        let webcamRetryTimer = null;
        async function startWebcam() {
            try {
                if (videoStream) { videoStream.getTracks().forEach(t => t.stop()); videoStream = null; }

                const video = { width: { ideal: 640 }, height: { ideal: 480 } };
                if (settings.cameraId) video.deviceId = { exact: settings.cameraId };
                else video.facingMode = 'user';

                videoStream = await navigator.mediaDevices.getUserMedia({ video });
                webcamPreview.srcObject = videoStream;
                await webcamPreview.play();
                webcamPreview.className = 'visible';
                updateStatus('Face tracking active');
                statusElement.className = 'good';

                // Auto-recover if the (possibly external / outdoor) camera drops out.
                videoStream.getVideoTracks().forEach(track => {
                    track.addEventListener('ended', scheduleWebcamRecovery);
                });

                await populateCameraList();
            } catch (error) {
                console.error('Error starting webcam:', error);
                // A remembered device may have been unplugged — fall back to the default camera.
                if (settings.cameraId) {
                    console.warn('Selected camera failed, falling back to default');
                    settings.cameraId = ''; saveSettings();
                    return startWebcam();
                }
                showError('Camera unavailable — retrying…');
                scheduleWebcamRecovery();
            }
        }

        function scheduleWebcamRecovery() {
            if (webcamRetryTimer) return;
            updateStatus('Camera lost — reconnecting…');
            statusElement.className = 'bad';
            webcamRetryTimer = setTimeout(async () => {
                webcamRetryTimer = null;
                await startWebcam();
            }, 3000);
        }

        async function populateCameraList() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
            const devices = await navigator.mediaDevices.enumerateDevices();
            const cams = devices.filter(d => d.kind === 'videoinput');
            cameraSelect.innerHTML = '';
            cams.forEach((cam, i) => {
                const opt = document.createElement('option');
                opt.value = cam.deviceId;
                opt.textContent = cam.label || `Camera ${i + 1}`;
                cameraSelect.appendChild(opt);
            });
            if (settings.cameraId) cameraSelect.value = settings.cameraId;
        }

        // ═══════════════════════════════════════
        //  FACE PROCESSING
        // ═══════════════════════════════════════

        function processFaceTracking() {
            if (previewMode) { if (avatarModel) avatarModel.visible = true; return; }
            if (!faceLandmarker || !webcamPreview.videoWidth) return;

            const currentTime = webcamPreview.currentTime;
            if (currentTime === lastVideoTime) return;
            lastVideoTime = currentTime;

            try {
                const results = faceLandmarker.detectForVideo(webcamPreview, performance.now());
                const hasFace = results.faceBlendshapes && results.faceBlendshapes.length > 0;

                if (hasFace) {
                    faceDetectionCounter = Math.min(faceDetectionCounter + 2, FACE_LOST_THRESHOLD);
                } else {
                    faceDetectionCounter = Math.max(faceDetectionCounter - 1, 0);
                }

                const shouldBeVisible = faceDetectionCounter >= FACE_DETECT_THRESHOLD;

                if (shouldBeVisible && !faceDetected) {
                    faceDetected = true;
                    updateAvatarVisibility(true);
                } else if (!shouldBeVisible && faceDetected && faceDetectionCounter === 0) {
                    faceDetected = false;
                    updateAvatarVisibility(false);
                }

                // Extract head position for off-axis projection
                if (results.faceLandmarks && results.faceLandmarks.length > 0) {
                    extractHeadPosition(results.faceLandmarks[0]);
                } else if (Date.now() - lastFaceTime > 3000) {
                    tracking = false;
                    updateStatus('No face detected — move into frame');
                    statusElement.className = 'bad';
                    webcamPreview.className = 'visible';
                }

                if (!faceDetected || !avatarModel) return;

                if (results.faceBlendshapes && results.faceBlendshapes.length > 0) {
                    applyBlendshapes(results.faceBlendshapes[0].categories);
                    try {
                        const hud=document.getElementById('rigdebug');
                        if(hud){
                            const j=(smoothedBlendshapes['jawOpen']||0).toFixed(2);
                            const bl=(smoothedBlendshapes['eyeBlinkLeft']||0).toFixed(2);
                            const br=(smoothedBlendshapes['eyeBlinkRight']||0).toFixed(2);
                            hud.textContent='LIVE  jawOpen='+j+'  blinkL='+bl+'  blinkR='+br;
                        }
                    } catch(e){}
                    if (proceduralMeshes.length > 0) applyProceduralDeformation();
                }

                if (results.facialTransformationMatrixes && results.facialTransformationMatrixes.length > 0) {
                    applyHeadRotation(results.facialTransformationMatrixes[0]);
                }

            } catch (error) {
                console.error('Face tracking error:', error);
            }
        }

        function extractHeadPosition(landmarks) {
            lastFaceTime = Date.now();
            tracking = true;

            let midX, midY;

            if (landmarks.length > 473) {
                const leftIris = landmarks[468];
                const rightIris = landmarks[473];
                midX = (leftIris.x + rightIris.x) / 2;
                midY = (leftIris.y + rightIris.y) / 2;

                headX = -(midX - 0.5) * CONFIG.screenWidthCm;
                headY = -(midY - 0.5) * CONFIG.screenHeightCm;

                const ipdNormalized = Math.sqrt(
                    Math.pow(leftIris.x - rightIris.x, 2) +
                    Math.pow(leftIris.y - rightIris.y, 2)
                );
                headZ = Math.max(30, Math.min(100,
                    (CONFIG.avgIpdCm * 5.5) / ipdNormalized
                ));
            } else {
                const nose = landmarks[1];
                midX = nose.x;
                midY = nose.y;
                headX = -(midX - 0.5) * CONFIG.screenWidthCm;
                headY = -(midY - 0.5) * CONFIG.screenHeightCm;
                headZ = CONFIG.defaultDistanceCm;
            }

            const edgeMargin = 0.15;
            const nearEdge = midX < edgeMargin || midX > (1 - edgeMargin) ||
                             midY < edgeMargin || midY > (1 - edgeMargin);

            if (nearEdge) {
                updateStatus('Tracking (center face for best results)');
                statusElement.className = 'warn';
                webcamPreview.className = 'visible';
            } else {
                updateStatus('Tracking');
                statusElement.className = 'good';
                webcamPreview.className = 'tracking';
            }
        }

        // ═══════════════════════════════════════
        //  ✨ COSMIC CHARACTER STYLING
        // ═══════════════════════════════════════
        const COSMIC = {
            enabled: true,
            skin:      new THREE.Color(0x6d4bff),  // nebula violet base tint
            glow:      new THREE.Color(0x8fd3ff),  // cyan celestial rim glow
            emissive:  0.35,   // how much inner glow
            rimPower:  2.2,    // fresnel falloff (higher = thinner rim)
            rimStrength: 1.4,
        };

        function applyCosmicStyle(root) {
            root.traverse((child) => {
                if (!child.isMesh || !child.material) return;
                const mats = Array.isArray(child.material) ? child.material : [child.material];
                mats.forEach((mat) => {
                    if (mat.userData.__cosmic) return;
                    mat.userData.__cosmic = true;
                    // nebula tint + inner emissive
                    if (mat.color) mat.color.lerp(COSMIC.skin, 0.35);
                    if ('emissive' in mat) {
                        mat.emissive = COSMIC.skin.clone();
                        mat.emissiveIntensity = COSMIC.emissive;
                    }
                    // fresnel rim glow via onBeforeCompile
                    mat.onBeforeCompile = (shader) => {
                        shader.uniforms.uRimColor = { value: COSMIC.glow };
                        shader.uniforms.uRimPower = { value: COSMIC.rimPower };
                        shader.uniforms.uRimStrength = { value: COSMIC.rimStrength };
                        shader.fragmentShader = shader.fragmentShader
                          .replace('#include <common>',
                            '#include <common>\nuniform vec3 uRimColor;\nuniform float uRimPower;\nuniform float uRimStrength;\nvarying vec3 vCosmicNormal;\nvarying vec3 vCosmicView;')
                          .replace('#include <output_fragment>',
                            'float rim = pow(1.0 - max(dot(normalize(vCosmicNormal), normalize(vCosmicView)), 0.0), uRimPower);\ngl_FragColor.rgb += uRimColor * rim * uRimStrength;\n#include <output_fragment>');
                        shader.vertexShader = shader.vertexShader
                          .replace('#include <common>',
                            '#include <common>\nvarying vec3 vCosmicNormal;\nvarying vec3 vCosmicView;')
                          .replace('#include <begin_vertex>',
                            '#include <begin_vertex>\nvCosmicNormal = normalize(normalMatrix * normal);\nvCosmicView = normalize(-(modelViewMatrix * vec4(transformed,1.0)).xyz);');
                        mat.userData.__shader = shader;
                    };
                    mat.needsUpdate = true;
                });
            });
        }

        // ═══════════════════════════════════════
        //  AVATAR VISIBILITY
        // ═══════════════════════════════════════

        function updateAvatarVisibility(visible) {
            if (!avatarModel) return;

            if (visible && !avatarVisible) {
                avatarVisible = true;
                avatarModel.visible = true;
                showFacePlaceholder(false);
                avatarModel.traverse((child) => {
                    if (child.isMesh && child.material) {
                        child.material.transparent = true;
                        child.material.opacity = 0;
                    }
                });
                fadeAvatar(0, 1, 300);
            } else if (!visible && avatarVisible) {
                fadeAvatar(1, 0, 300).then(() => {
                    avatarVisible = false;
                    if (avatarModel) avatarModel.visible = false;
                    showFacePlaceholder(true);
                });
            }
        }

        function fadeAvatar(from, to, duration) {
            return new Promise((resolve) => {
                const startTime = performance.now();
                function tick() {
                    const elapsed = performance.now() - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = progress * (2 - progress);
                    const opacity = from + (to - from) * eased;
                    if (avatarModel) {
                        avatarModel.traverse((child) => {
                            if (child.isMesh && child.material) child.material.opacity = opacity;
                        });
                    }
                    if (progress < 1) requestAnimationFrame(tick);
                    else resolve();
                }
                tick();
            });
        }

        // ═══════════════════════════════════════
        //  BLENDSHAPES & HEAD ROTATION
        // ═══════════════════════════════════════

        function applyBlendshapes(categories) {
            // If calibrating, accumulate raw scores to compute the neutral baseline.
            if (calibrating) {
                for (const cat of categories) {
                    calibrateAccum[cat.categoryName] = (calibrateAccum[cat.categoryName] || 0) + cat.score;
                }
                calibrateSamples++;
            }
            for (const cat of categories) {
                const name = cat.categoryName;
                // apply neutral-subtraction + per-channel gain BEFORE smoothing
                const score = calibratedScore(name, cat.score);
                if (smoothedBlendshapes[name] === undefined) smoothedBlendshapes[name] = score;
                else smoothedBlendshapes[name] = smoothedBlendshapes[name] * (1 - SMOOTHING_FACTOR) + score * SMOOTHING_FACTOR;

                if (morphTargetIndices[name]) {
                    for (const t of morphTargetIndices[name]) {
                        t.mesh.morphTargetInfluences[t.index] = smoothedBlendshapes[name];
                    }
                }
            }
        }

        // Capture ~1s of the user's resting face and store it as the neutral baseline.
        function startCalibration() {
            calibrating = true; calibrateSamples = 0; calibrateAccum = {};
            const btn = document.getElementById('calibrate-btn');
            if (btn) { btn.textContent = 'Hold still…'; btn.disabled = true; }
            setTimeout(() => {
                calibrating = false;
                if (calibrateSamples > 0) {
                    for (const k in calibrateAccum) neutralBlendshapes[k] = calibrateAccum[k] / calibrateSamples;
                    calibrated = true;
                }
                if (btn) { btn.textContent = 'Recalibrate'; btn.disabled = false; }
            }, 1000);
        }
        window.startCalibration = startCalibration;

        function applyHeadRotation(matrix) {
            if (!headBone) return;
            const mat4 = new THREE.Matrix4();
            mat4.fromArray(matrix.data);
            const euler = new THREE.Euler();
            euler.setFromRotationMatrix(mat4, 'XYZ');

            smoothedRotation.pitch = smoothedRotation.pitch * (1 - SMOOTHING_FACTOR) + euler.x * SMOOTHING_FACTOR;
            smoothedRotation.yaw = smoothedRotation.yaw * (1 - SMOOTHING_FACTOR) + euler.y * SMOOTHING_FACTOR;
            smoothedRotation.roll = smoothedRotation.roll * (1 - SMOOTHING_FACTOR) + euler.z * SMOOTHING_FACTOR;

            if (!headBone.userData.originalRotation) {
                headBone.userData.originalRotation = headBone.rotation.clone();
            }
            const orig = headBone.userData.originalRotation;
            headBone.rotation.x = orig.x + smoothedRotation.pitch * 0.7;
            headBone.rotation.y = orig.y - smoothedRotation.yaw * 0.8;
            headBone.rotation.z = orig.z - smoothedRotation.roll * 0.4;
        }

        // ═══════════════════════════════════════
        //  PROCEDURAL ANIMATION (fallback)
        // ═══════════════════════════════════════

        function setupProceduralAnimation() {
            proceduralMeshes = [];
            if (!avatarModel) return;

            const box = new THREE.Box3().setFromObject(avatarModel);
            modelBounds.min.copy(box.min);
            modelBounds.max.copy(box.max);
            box.getCenter(modelBounds.center);

            avatarModel.traverse((child) => {
                if (child.isMesh && child.geometry) {
                    const geometry = child.geometry;
                    const position = geometry.attributes.position;
                    if (!position) return;

                    const originalPositions = new Float32Array(position.array.length);
                    originalPositions.set(position.array);

                    const vertexCount = position.count;
                    const jawIndices = [], upperFaceIndices = [];
                    const leftEyeIndices = [], rightEyeIndices = [], mouthIndices = [];

                    const meshBox = new THREE.Box3().setFromBufferAttribute(position);
                    const meshHeight = meshBox.max.y - meshBox.min.y;
                    const meshWidth = meshBox.max.x - meshBox.min.x;
                    const meshCenter = new THREE.Vector3();
                    meshBox.getCenter(meshCenter);

                    for (let i = 0; i < vertexCount; i++) {
                        const y = position.getY(i);
                        const x = position.getX(i);
                        const normalizedY = (y - meshBox.min.y) / meshHeight;
                        const normalizedX = (x - meshCenter.x) / (meshWidth / 2);

                        if (normalizedY < 0.35) {
                            jawIndices.push(i);
                            if (normalizedY < 0.25) mouthIndices.push(i);
                        }
                        if (normalizedY > 0.7) upperFaceIndices.push(i);
                        if (normalizedY > 0.45 && normalizedY < 0.75) {
                            if (normalizedX < -0.15) leftEyeIndices.push(i);
                            else if (normalizedX > 0.15) rightEyeIndices.push(i);
                        }
                    }

                    proceduralMeshes.push({
                        mesh: child, geometry, originalPositions,
                        jawIndices, upperFaceIndices, leftEyeIndices,
                        rightEyeIndices, mouthIndices, meshBox, meshHeight
                    });
                }
            });
        }

        function applyProceduralDeformation() {
            if (proceduralMeshes.length === 0) return;

            const jawOpen = smoothedBlendshapes['jawOpen'] || 0;
            const mouthSmileLeft = smoothedBlendshapes['mouthSmileLeft'] || 0;
            const mouthSmileRight = smoothedBlendshapes['mouthSmileRight'] || 0;
            const eyeBlinkLeft = smoothedBlendshapes['eyeBlinkLeft'] || 0;
            const eyeBlinkRight = smoothedBlendshapes['eyeBlinkRight'] || 0;
            const browInnerUp = smoothedBlendshapes['browInnerUp'] || 0;
            const mouthPucker = smoothedBlendshapes['mouthPucker'] || 0;
            const cheekPuff = smoothedBlendshapes['cheekPuff'] || 0;

            for (const data of proceduralMeshes) {
                const position = data.geometry.attributes.position;
                const original = data.originalPositions;
                const height = data.meshHeight;

                const jawStrength = height * 0.15;
                const eyeStrength = height * 0.03;
                const browStrength = height * 0.04;
                const smileStrength = height * 0.05;
                const puckerStrength = height * 0.03;
                const puffStrength = height * 0.04;

                for (const i of data.jawIndices) {
                    const origY = original[i * 3 + 1];
                    const origZ = original[i * 3 + 2];
                    const normalizedY = (origY - data.meshBox.min.y) / height;
                    const weight = Math.max(0, 1 - normalizedY / 0.35);
                    position.setY(i, origY - jawOpen * jawStrength * weight);
                    position.setZ(i, origZ - jawOpen * jawStrength * 0.3 * weight);
                }

                for (const i of data.mouthIndices) {
                    const origX = original[i * 3];
                    const origY = original[i * 3 + 1];
                    const origZ = original[i * 3 + 2];
                    const meshCenterX = data.meshBox.min.x + (data.meshBox.max.x - data.meshBox.min.x) / 2;
                    const smileAmount = (mouthSmileLeft + mouthSmileRight) / 2;
                    const sideWeight = Math.abs(origX - meshCenterX) / ((data.meshBox.max.x - data.meshBox.min.x) / 2);
                    position.setY(i, position.getY(i) + smileAmount * smileStrength * sideWeight);
                    const puckerInward = (origX - meshCenterX) * mouthPucker * 0.3;
                    position.setX(i, origX - puckerInward);
                    position.setZ(i, position.getZ(i) + mouthPucker * puckerStrength);
                }

                for (const i of data.leftEyeIndices) {
                    position.setY(i, original[i * 3 + 1] - eyeBlinkLeft * eyeStrength);
                }
                for (const i of data.rightEyeIndices) {
                    position.setY(i, original[i * 3 + 1] - eyeBlinkRight * eyeStrength);
                }
                for (const i of data.upperFaceIndices) {
                    position.setY(i, original[i * 3 + 1] + browInnerUp * browStrength);
                }

                if (cheekPuff > 0.1) {
                    for (const i of data.jawIndices) {
                        const origX = original[i * 3];
                        const origZ = original[i * 3 + 2];
                        const meshCenterX = data.meshBox.min.x + (data.meshBox.max.x - data.meshBox.min.x) / 2;
                        const side = origX > meshCenterX ? 1 : -1;
                        position.setX(i, origX + side * cheekPuff * puffStrength);
                        position.setZ(i, position.getZ(i) + cheekPuff * puffStrength * 0.5);
                    }
                }

                position.needsUpdate = true;
                data.geometry.computeVertexNormals();
            }
        }

        // ═══════════════════════════════════════
        //  SNAPSHOT CAPTURE + ATTRACT GALLERY
        // ═══════════════════════════════════════

        // Downscale the live 3D canvas to a lightweight JPEG for the cycling gallery.
        function snapshotComposite() {
            const src = renderer.domElement;
            if (!src.width) return null;
            const targetW = 640;
            const scale = targetW / src.width;
            const c = document.createElement('canvas');
            c.width = targetW;
            c.height = Math.round(src.height * scale);
            const ctx = c.getContext('2d');
            ctx.drawImage(src, 0, 0, c.width, c.height);
            try {
                return c.toDataURL('image/jpeg', 0.72);
            } catch (e) {
                console.warn('Snapshot failed', e);
                return null;
            }
        }

        function captureVisitor() {
            if (!settings.captureEnabled) return;
            const data = snapshotComposite();
            if (!data) return;
            gallery.push(data);
            while (gallery.length > MAX_GALLERY) gallery.shift();
            persistGallery();
            capturedThisVisit = true;
            lastCaptureAt = performance.now();
        }

        // localStorage can overflow with many images — trim oldest until it fits.
        function persistGallery() {
            for (;;) {
                try {
                    localStorage.setItem(GALLERY_KEY, JSON.stringify(gallery));
                    break;
                } catch (e) {
                    if (gallery.length <= 1) { gallery = []; localStorage.removeItem(GALLERY_KEY); break; }
                    gallery.shift();
                }
            }
            if (captureCountEl) captureCountEl.textContent = gallery.length;
        }

        // Cross-fade through saved snapshots while in attract mode.
        let galleryImgA, galleryImgB, galleryIndex = 0, galleryFront = null, galleryTimer = 0;
        function initGalleryImgs() {
            galleryImgA = document.createElement('img');
            galleryImgB = document.createElement('img');
            attractGallery.appendChild(galleryImgA);
            attractGallery.appendChild(galleryImgB);
        }
        function advanceGallery() {
            if (gallery.length === 0) return;
            const next = galleryFront === galleryImgA ? galleryImgB : galleryImgA;
            const front = galleryFront === galleryImgA ? galleryImgA : (galleryFront === galleryImgB ? galleryImgB : null);
            next.src = gallery[galleryIndex % gallery.length];
            galleryIndex++;
            next.classList.add('show');
            if (front) front.classList.remove('show');
            galleryFront = next;
        }

        function setAttract(active) {
            if (active === attractActive) return;
            attractActive = active;
            attractEl.classList.toggle('visible', active);
            if (active) {
                galleryIndex = 0; galleryTimer = 0;
                if (gallery.length) advanceGallery();
            } else {
                if (galleryImgA) galleryImgA.classList.remove('show');
                if (galleryImgB) galleryImgB.classList.remove('show');
                galleryFront = null;
            }
        }

        // Called every frame to drive attract/capture timing.
        function updateInstallation(now) {
            if (previewMode) return; // static preview: no attract loop, no auto-capture
            // Enter attract mode after a stretch with no face; leave the instant someone appears.
            if (faceDetected) {
                attractTimer = now;
                if (attractActive) setAttract(false);

                // Auto-capture once the visitor holds steady.
                if (settings.captureEnabled && avatarVisible) {
                    if (!faceStableSince) faceStableSince = now;
                    if (!capturedThisVisit &&
                        now - faceStableSince > CAPTURE_HOLD_MS &&
                        now - lastCaptureAt > CAPTURE_COOLDOWN_MS) {
                        captureVisitor();
                    }
                } else {
                    faceStableSince = 0;
                }
            } else {
                faceStableSince = 0;
                capturedThisVisit = false; // reset so the next visitor gets captured
                if (!attractActive && now - attractTimer > ATTRACT_DELAY_MS) setAttract(true);
            }

            if (attractActive && gallery.length > 1) {
                galleryTimer += 0.016;
                if (galleryTimer > 3.5) { galleryTimer = 0; advanceGallery(); }
            }
        }

        // ═══════════════════════════════════════
        //  ANIMATION LOOP
        // ═══════════════════════════════════════

        function animate() {
            requestAnimationFrame(animate);
            animationTime += 0.016; // ~60fps

            updateOffAxisProjection();
            processFaceTracking();
            updateInstallation(performance.now());

            // Animate wireframe objects with rotation and floating
            for (let i = 0; i < wireframeObjects.length; i++) {
                const obj = wireframeObjects[i];
                const base = wireframeBasePositions[i];

                // Rotation
                obj.rotation.x += 0.002 + i * 0.0005;
                obj.rotation.y += 0.003 + i * 0.0003;

                // Floating/bobbing motion
                const floatOffset = Math.sin(animationTime * base.speed + i * 1.5) * base.amplitude;
                const swayOffset = Math.cos(animationTime * base.speed * 0.5 + i) * base.amplitude * 0.3;
                obj.position.y = base.y + floatOffset;
                obj.position.x = base.x + swayOffset;
            }

            renderer.render(scene, camera);
        }

        // ═══════════════════════════════════════
        //  UI HELPERS
        // ═══════════════════════════════════════

        function showLoading(text, subtext = '') {
            loadingText.textContent = text;
            loadingSubtext.textContent = subtext;
            loadingOverlay.classList.remove('hidden');
        }

        function hideLoading() {
            loadingOverlay.classList.add('hidden');
        }

        function showFacePlaceholder(show) {
            if (show) {
                facePlaceholder.classList.add('visible');
            } else {
                facePlaceholder.classList.remove('visible');
            }
        }

        function updateStatus(text) {
            statusElement.textContent = text;
        }

        function showError(text) {
            errorMessage.textContent = text;
            errorMessage.style.display = 'block';
            setTimeout(() => { errorMessage.style.display = 'none'; }, 5000);
        }

        // ═══════════════════════════════════════
        //  MODEL SWITCHING
        // ═══════════════════════════════════════

        async function switchModel(modelUrl) {
            if (modelUrl === currentModelUrl) return;
            currentModelUrl = modelUrl;
            modelButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.model === modelUrl);
            });
            headBone = null;
            proceduralMeshes = [];
            await loadGLBModel(modelUrl);
        }

        modelButtons.forEach(btn => {
            btn.addEventListener('click', () => switchModel(btn.dataset.model));
        });

        // ═══════════════════════════════════════
        //  SETUP PANEL + KIOSK CONTROLS
        // ═══════════════════════════════════════

        function applyKiosk() {
            document.body.classList.toggle('kiosk', settings.kiosk);
            if (toggleKioskBtn) toggleKioskBtn.textContent = settings.kiosk ? 'On' : 'Off';
        }
        function applyCaptureToggle() {
            if (toggleCaptureBtn) toggleCaptureBtn.textContent = settings.captureEnabled ? 'On' : 'Off';
        }

        function setupPanelControls() {
            document.getElementById('setup-close').addEventListener('click', () => setupPanel.classList.remove('open'));

            cameraSelect.addEventListener('change', async () => {
                settings.cameraId = cameraSelect.value; saveSettings();
                await startWebcam();
            });

            modelSelect.value = currentModelUrl;
            modelSelect.addEventListener('change', () => switchModel(modelSelect.value));

            toggleKioskBtn.addEventListener('click', () => { settings.kiosk = !settings.kiosk; saveSettings(); applyKiosk(); });
            toggleCaptureBtn.addEventListener('click', () => { settings.captureEnabled = !settings.captureEnabled; saveSettings(); applyCaptureToggle(); });

            document.getElementById('enter-fullscreen').addEventListener('click', enterFullscreen);
            document.getElementById('clear-gallery').addEventListener('click', () => {
                gallery = []; persistGallery();
                if (galleryImgA) galleryImgA.classList.remove('show');
                if (galleryImgB) galleryImgB.classList.remove('show');
                galleryFront = null;
            });

            applyKiosk();
            applyCaptureToggle();
            captureCountEl.textContent = gallery.length;
        }

        function enterFullscreen() {
            const el = document.documentElement;
            if (document.fullscreenElement) document.exitFullscreen();
            else if (el.requestFullscreen) el.requestFullscreen().catch(() => {});
        }

        // Hidden keyboard shortcuts for on-site operators.
        document.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            if (k === 's') setupPanel.classList.toggle('open');
            else if (k === 'k') { settings.kiosk = !settings.kiosk; saveSettings(); applyKiosk(); }
            else if (k === 'f') enterFullscreen();
        });

        // Keep the on-screen model buttons and the setup dropdown in sync.
        const _switchModel = switchModel;
        switchModel = async function(url) {
            if (modelSelect) modelSelect.value = url;
            await _switchModel(url);
        };

        // ═══════════════════════════════════════
        //  INIT
        // ═══════════════════════════════════════

        async function init() {
            initThreeJS();
            enableMouseFallback();
            initGalleryImgs();

            // Optional ?avatar= to preselect an avatar by name or path
            // (e.g. ?avatar=character, or combine with ?preview to see it without a face).
            const avatarParam = new URLSearchParams(location.search).get('avatar');
            if (avatarParam) {
                const map = {
                    character: 'vendor/avatar-character.glb',
                    face: 'vendor/facecap.glb',
                    alien: 'alien.glb', alien1: 'alien.glb', alien2: 'alien2.glb'
                };
                currentModelUrl = map[avatarParam.toLowerCase()] || avatarParam;
                modelButtons.forEach(b => b.classList.toggle('active', b.dataset.model === currentModelUrl));
            }

            setupPanelControls();
            animate();

            await loadGLBModel(currentModelUrl);
            await initFaceLandmarker();
            if (faceLandmarker && avatarModel) await startWebcam();
        }

        init();
    </script>
