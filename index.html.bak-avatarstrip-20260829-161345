        // ═══════════════════════════════════════
        //  AVATAR LOADING
        // ═══════════════════════════════════════

        // ARKit-rigged avatars (e.g. facecap.glb) are meshopt-compressed with KTX2
        // textures, so the loader needs both decoders. Created lazily once.
        let ktx2Loader = null;
        function getKTX2Loader() {
            if (!ktx2Loader) {
                ktx2Loader = new KTX2Loader()
                    .setTranscoderPath('./vendor/three/addons/libs/basis/')
                    .detectSupport(renderer);
            }
            return ktx2Loader;
        }

        // MediaPipe emits blendshapes like "eyeBlinkLeft"; some rigs (facecap) name
        // them "eyeBlink_L". Resolve whichever spelling the model actually has.
        function morphKeyFor(dict, name) {
            if (dict[name] !== undefined) return name;
            const alt = name.replace(/Left$/, '_L').replace(/Right$/, '_R');
            if (dict[alt] !== undefined) return alt;
            return undefined;
        }

        async function loadGLBModel(fileOrUrl) {
            showLoading('Loading Avatar', 'Preparing your alien companion...');
            const loader = new GLTFLoader();
            loader.setMeshoptDecoder(MeshoptDecoder);
            loader.setKTX2Loader(getKTX2Loader());
            const isFile = fileOrUrl instanceof File;
            const url = isFile ? URL.createObjectURL(fileOrUrl) : fileOrUrl;

            try {
                const gltf = await new Promise((resolve, reject) => {
                    loader.load(url, resolve, (xhr) => {
                        if (xhr && xhr.total) {
                            const pct = Math.round((xhr.loaded / xhr.total) * 100);
                            showLoading('Loading Avatar', 'Downloading ' + pct + '%');
                        } else if (xhr && xhr.loaded) {
                            showLoading('Loading Avatar', 'Downloading ' + Math.round(xhr.loaded/1e6) + ' MB');
                        }
                    }, reject);
                });
                showLoading('Loading Avatar', 'Preparing meshes...');

                if (avatarModel) scene.remove(avatarModel);
                avatarModel = gltf.scene;
                scene.add(avatarModel);

                morphTargetMeshes = [];
                morphTargetIndices = {};

                avatarModel.traverse((child) => {
                    if (child.isMesh && child.morphTargetInfluences && child.morphTargetDictionary) {
                        morphTargetMeshes.push(child);
                        for (const name of BLENDSHAPE_NAMES) {
                            const key = morphKeyFor(child.morphTargetDictionary, name);
                            if (key !== undefined) {
                                if (!morphTargetIndices[name]) morphTargetIndices[name] = [];
                                morphTargetIndices[name].push({
                                    mesh: child,
                                    index: child.morphTargetDictionary[key]
                                });
                            }
                        }
                        child.castShadow = true;
                        child.receiveShadow = true;
                    }
                    if (child.isBone) {
                        const boneName = child.name.toLowerCase();
                        if (boneName.includes('head') && !boneName.includes('headtop') && !boneName.includes('end')) {
                            headBone = child;
                        }
                    }
                });

                if (!headBone) headBone = avatarModel;

                // ✨ COSMIC CHARACTER STYLING (cosmic-character branch)
                if (COSMIC.enabled) applyCosmicStyle(avatarModel);

                // Full-body avatars (Ready Player Me style) → frame as a floating head:
                // hide body/outfit meshes so only the head + eyes + teeth + hair remain.
                const bodyRe = /body|outfit|footwear|shoe/i;
                let hasBody = false;
                avatarModel.traverse((c) => { if (c.isMesh && bodyRe.test(c.name)) hasBody = true; });
                if (hasBody) {
                    avatarModel.traverse((c) => { if (c.isMesh && bodyRe.test(c.name)) c.visible = false; });
                }

                // Scale and position inside wireframe room. Frame on the *visible* meshes,
                // so a full-body avatar frames on its head rather than the whole body.
                avatarModel.updateWorldMatrix(true, true);
                const box = new THREE.Box3();
                avatarModel.traverse((c) => { if (c.isMesh && c.visible && c.geometry) box.expandByObject(c); });
                if (box.isEmpty()) box.setFromObject(avatarModel);
                const center = box.getCenter(new THREE.Vector3());
                const size = box.getSize(new THREE.Vector3());
                const maxDim = Math.max(size.x, size.y, size.z);
                const scale = CONFIG.alienScale / maxDim;

                avatarModel.scale.setScalar(scale);
                avatarModel.position.x = -center.x * scale;
                avatarModel.position.y = -center.y * scale;
                avatarModel.position.z = -center.z * scale + CONFIG.alienDepth;

                const morphCount = Object.keys(morphTargetIndices).length;
                try {
                    const hud=document.getElementById('rigdebug');
                    if(hud){
                        const names=Object.keys(morphTargetIndices);
                        hud.textContent='rig morphs: '+morphCount+'\n'+names.join(', ')+'\nmeshes with morphs: '+morphTargetMeshes.length;
                    }
                } catch(e){}
                if (morphCount === 0 && morphTargetMeshes.length === 0) {
                    setupProceduralAnimation();
                } else {
                    proceduralMeshes = [];  // rig has real morph targets; never jiggle
                }

                avatarModel.visible = false;
                avatarVisible = false;
                faceDetected = false;
                showFacePlaceholder(true);
                updateStatus('Move into frame to activate avatar');
                statusElement.className = '';

                if (previewMode) {
                    avatarModel.visible = true;
                    avatarVisible = true;
                    showFacePlaceholder(false);
                }

                hideLoading();
                if (isFile) URL.revokeObjectURL(url);
                if (faceLandmarker && !videoStream) await startWebcam();

            } catch (error) {
                console.error('Error loading model:', error);
                showError('Failed to load model: ' + error.message);
                hideLoading();
                if (isFile) URL.revokeObjectURL(url);
            }
        }

